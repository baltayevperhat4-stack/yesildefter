# --- veri tabanı -------------------------------------------------------------
# Boş bırakılırsa data/yesildefter.db (SQLite) kullanılır.
# Railway/Heroku PostgreSQL için otomatik gelir.
# DATABASE_URL=postgresql://kullanici:parola@host:5432/yesildefter

# --- erişim koruması ---------------------------------------------------------
# Tanımlıysa tüm uygulama HTTP Basic ile korunur. İnternete açık dağıtımda
# ZORUNLUDUR; yerel çalıştırmada boş bırakın.
# YD_PAROL=guclu-bir-parola
# YD_KULLANICI=jury

# --- davranış ----------------------------------------------------------------
YD_CONFIDENCE_THRESHOLD=0.90   # insan onayı eşiği
YD_CBAM_CERT_EUR=75            # CBAM sertifika fiyatı varsayımı (€/tCO2e)
YD_DEFAULT_LANG=tr             # tr | uz | ru | en | tk

# --- isteğe bağlı dil modeli -------------------------------------------------
# Anahtar verilmezse sistem kural tabanlı çıkarımla tam çalışır.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# YD_LLM_PROVIDER=auto         # auto | anthropic | openai | none
# YD_LLM_MODEL=claude-sonnet-4-5

# --- isteğe bağlı Telegram botu ----------------------------------------------
# TELEGRAM_BOT_TOKEN=

# --- güvenlik / üretim -------------------------------------------------------
YD_ALLOW_DEMO_RESET=0          # üretimde 0: /demo tüm veriyi siler
YD_MAX_UPLOAD_MB=25
YD_MAX_REPORTS=20
YD_DATA_DIR=/data              # Docker'da kalıcı birim

# --- tedarikçiye e-posta (isteğe bağlı) --------------------------------------
# Tanımsızsa istekler yalnızca hazırlanır, gönderildi olarak işaretlenmez.
# YD_SMTP_HOST=
# YD_SMTP_PORT=587
# YD_SMTP_USER=
# YD_SMTP_PASSWORD=
# YD_SMTP_FROM=
# YD_SMTP_TLS=1

# --- Telegram ----------------------------------------------------------------
# Boş bırakılırsa bot hiç kimseye yanıt vermez (güvenli varsayılan).
# TELEGRAM_ALLOWED_CHATS=123456789,987654321

# --- yapay zekâ (ayarlar sayfasından da girilebilir) -------------------------
# Anahtarın biçiminden sağlayıcı tanınır; hiçbiri zorunlu değildir.
# ANTHROPIC_API_KEY=sk-ant-...
# YD_LLM_PROVIDER=auto      # auto | anthropic | openai | google | groq |
#                           # openrouter | deepseek | mistral | together |
#                           # uyumlu | none
# YD_LLM_MODEL=
# YD_LLM_BASE_URL=          # OpenAI uyumlu uç nokta, örn. http://localhost:11434/v1
# YD_LLM_FACTOR_SUGGEST=1   # tanınmayan satır için faktör önerisi
# YD_LLM_EXPLAIN=1          # sade dilde açıklama
# YD_LLM_EMAIL_DRAFT=1      # tedarikçi e-posta taslağı
